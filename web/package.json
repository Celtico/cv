{
  "name": "cv-celesti-tico",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "next lint",
    "build:prod": "NEXT_DIST_DIR=.next-prod next build && npm run _stage:prod",
    "start:prod": "PORT=3200 node .next-prod/standalone/server.js",
    "prod": "npm run build:prod && npm run start:prod",
    "_stage:prod": "rm -rf .next-prod/standalone/public .next-prod/standalone/.next-prod/static && cp -r public .next-prod/standalone/public && cp -r .next-prod/static .next-prod/standalone/.next-prod/static",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "node --test --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.4",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "framer-motion": "^11.11.17",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
